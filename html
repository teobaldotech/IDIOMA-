            // Render Choices
            const optionsContainer = document.getElementById('dialogue-options-container');
            optionsContainer.innerHTML = '';

            step.options.forEach(opt => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-3 rounded-xl border border-slate-200 dark:border-slate-700 hover:border-indigo-500 dark:hover:border-indigo-500 bg-white dark:bg-slate-800 text-slate-700 dark:text-slate-200 text-xs font-medium transition-all";
                btn.innerText = opt.text;
                btn.onclick = () => handleDialogueChoice(opt);
                optionsContainer.appendChild(btn);
            });
        }

        function handleDialogueChoice(opt) {
            const container = document.getElementById('dialogue-messages');
            
            // User message bubble
            const userMsg = document.createElement('div');
            userMsg.className = "flex gap-3 max-w-[85%] ml-auto justify-end";
            userMsg.innerHTML = `
                <div class="p-3.5 bg-indigo-600 text-white rounded-2xl rounded-tr-none text-xs sm:text-sm space-y-1">
                    <p class="font-bold text-[10px] text-indigo-200">Você</p>
                    <p>${opt.text}</p>
                </div>
            `;
            container.appendChild(userMsg);
            container.scrollTop = container.scrollHeight;

            const optionsContainer = document.getElementById('dialogue-options-container');

            if (opt.correct) {
                addXP(15);
                if (opt.nextStep !== null && opt.nextStep !== undefined) {
                    currentDialogueStepIdx = opt.nextStep;
                    setTimeout(() => {
                        renderDialogueStep();
                    }, 600);
                } else {
                    optionsContainer.innerHTML = `
                        <div class="p-3 rounded-xl bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 text-emerald-800 dark:text-emerald-200 text-xs font-bold text-center">
                            <i class="fa-solid fa-circle-check mr-1"></i> Diálogo Concluído com Sucesso! (+45 XP Total)
                        </div>
                    `;
                }
            } else {
                optionsContainer.innerHTML = `
                    <div class="p-3 rounded-xl bg-rose-50 dark:bg-rose-950/40 border border-rose-200 dark:border-rose-800 text-rose-800 dark:text-rose-200 text-xs space-y-1">
                        <p class="font-bold"><i class="fa-solid fa-circle-xmark mr-1"></i> Resposta inadequada para este contexto.</p>
                        <p class="text-[11px] text-rose-600 dark:text-rose-300">${opt.feedback}</p>
                        <button onclick="renderDialogueStep()" class="mt-2 text-xs font-bold underline">Tentar Novamente</button>
                    </div>
                `;
            }
        }

        function restartDialogue() {
            selectDialogueScenario(currentScenarioKey);
        }

        /* ==========================================================================
           MODULE 4: FLASHCARDS LOGIC
           ========================================================================== */

        function updateFlashcardDisplay() {
            if (filteredFlashcards.length === 0) return;
            
            const card = filteredFlashcards[currentFlashcardIdx];
            document.getElementById('card-tag').innerText = card.category.replace('_', ' ');
            document.getElementById('card-english').innerText = card.english;
            document.getElementById('card-phonetic').innerText = card.phonetic;
            document.getElementById('card-portuguese').innerText = card.portuguese;
            document.getElementById('card-example').innerText = `"${card.example}"`;
            document.getElementById('card-example-pt').innerText = `"${card.examplePt}"`;
            document.getElementById('flashcard-counter').innerText = `${currentFlashcardIdx + 1} / ${filteredFlashcards.length}`;

            // Reset flip
            isCardFlipped = false;
            document.getElementById('flashcard-inner').classList.remove('rotate-y-180');
        }

        function flipCard() {
            isCardFlipped = !isCardFlipped;
            const inner = document.getElementById('flashcard-inner');
            if (isCardFlipped) {
                inner.classList.add('rotate-y-180');
            } else {
                inner.classList.remove('rotate-y-180');
            }
        }

        function nextFlashcard() {
            if (currentFlashcardIdx < filteredFlashcards.length - 1) {
                currentFlashcardIdx++;
                updateFlashcardDisplay();
            }
        }

        function prevFlashcard() {
            if (currentFlashcardIdx > 0) {
                currentFlashcardIdx--;
                updateFlashcardDisplay();
            }
        }

        function changeFlashcardCategory(cat) {
            if (cat === 'all') {
                filteredFlashcards = [...flashcardData];
            } else {
                filteredFlashcards = flashcardData.filter(item => item.category === cat);
            }
            currentFlashcardIdx = 0;
            updateFlashcardDisplay();
        }

        function speakFlashcard(event) {
            event.stopPropagation();
            if (filteredFlashcards.length > 0) {
                speakText(filteredFlashcards[currentFlashcardIdx].english);
            }
        }

        /* ==========================================================================
           INITIALIZATION
           ========================================================================== */
        window.addEventListener('DOMContentLoaded', () => {
            renderVocabGrid();
            loadGrammarQuestion();
            selectDialogueScenario('interview');
            updateFlashcardDisplay();
        });
    </script>
</body>
</html>
