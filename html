        function loadGrammarQuestion() {
            const current = grammarData[currentGrammarIdx];
            document.getElementById('grammar-progress-text').innerText = `${currentGrammarIdx + 1} / ${grammarData.length}`;
            document.getElementById('grammar-progress-bar').style.width = `${((currentGrammarIdx + 1) / grammarData.length) * 100}%`;
            
            document.getElementById('grammar-category').innerText = current.category;
            document.getElementById('grammar-question').innerText = current.question;
            
            const optionsContainer = document.getElementById('grammar-options');
            optionsContainer.innerHTML = '';

            const explanationEl = document.getElementById('grammar-explanation');
            explanationEl.classList.add('hidden');

            const nextBtn = document.getElementById('grammar-next-btn');
            nextBtn.disabled = true;
            nextBtn.className = "px-6 py-2.5 rounded-xl bg-slate-300 dark:bg-slate-700 text-slate-500 dark:text-slate-400 font-bold text-sm transition-all cursor-not-allowed";

            current.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-2xl border border-slate-200 dark:border-slate-700 hover:border-indigo-500 dark:hover:border-indigo-500 bg-slate-50/50 dark:bg-slate-900/30 text-slate-800 dark:text-slate-200 text-xs sm:text-sm font-medium transition-all flex items-center justify-between";
                btn.innerHTML = `<span>${opt}</span> <i class="fa-regular fa-circle text-slate-400"></i>`;
                btn.onclick = () => checkGrammarAnswer(idx, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function checkGrammarAnswer(selectedIndex, btn) {
            const current = grammarData[currentGrammarIdx];
            const optionsBtns = document.getElementById('grammar-options').children;

            for (let b of optionsBtns) {
                b.disabled = true;
                b.classList.add('opacity-60', 'cursor-not-allowed');
            }

            const explanationEl = document.getElementById('grammar-explanation');
            const expTitle = document.getElementById('grammar-explanation-title');
            const expBody = document.getElementById('grammar-explanation-body');
            explanationEl.classList.remove('hidden');

            if (selectedIndex === current.correct) {
                btn.className = "w-full text-left p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 text-xs sm:text-sm font-bold transition-all flex items-center justify-between";
                btn.querySelector('i').className = "fa-solid fa-circle-check text-emerald-500 text-base";
                
                expTitle.className = "font-bold flex items-center gap-2 text-emerald-600 dark:text-emerald-400";
                expTitle.innerHTML = `<i class="fa-solid fa-circle-check"></i> Correto! (+20 XP)`;
                explanationEl.className = "p-4 rounded-2xl border border-emerald-200 dark:border-emerald-800 bg-emerald-50/50 dark:bg-emerald-950/20 text-sm space-y-2";
                
                addXP(20);
                grammarScore++;
            } else {
                btn.className = "w-full text-left p-4 rounded-2xl border-2 border-rose-500 bg-rose-50 dark:bg-rose-950/40 text-rose-900 dark:text-rose-200 text-xs sm:text-sm font-bold transition-all flex items-center justify-between";
                btn.querySelector('i').className = "fa-solid fa-circle-xmark text-rose-500 text-base";

                // Highlight correct one
                const correctBtn = optionsBtns[current.correct];
                correctBtn.className = "w-full text-left p-4 rounded-2xl border-2 border-emerald-500 bg-emerald-50 dark:bg-emerald-950/40 text-emerald-900 dark:text-emerald-200 text-xs sm:text-sm font-bold transition-all flex items-center justify-between opacity-100";
                correctBtn.querySelector('i').className = "fa-solid fa-circle-check text-emerald-500 text-base";

                expTitle.className = "font-bold flex items-center gap-2 text-rose-600 dark:text-rose-400";
                expTitle.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Incorreto`;
                explanationEl.className = "p-4 rounded-2xl border border-rose-200 dark:border-rose-800 bg-rose-50/50 dark:bg-rose-950/20 text-sm space-y-2";
            }

            expBody.innerText = current.explanation;

            const nextBtn = document.getElementById('grammar-next-btn');
            nextBtn.disabled = false;
            nextBtn.className = "px-6 py-2.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm transition-all shadow-md shadow-indigo-500/20 cursor-pointer";
        }

